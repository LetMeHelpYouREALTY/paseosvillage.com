{
  "name": "paseosvillage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/validate-schema.ts && next build",
    "start": "next start",
    "lint": "eslint . && tsx scripts/fair-housing-check.ts",
    "validate-schema": "tsx scripts/validate-schema.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@next/third-parties": "16.3.4",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=11 <12"
  }
}
