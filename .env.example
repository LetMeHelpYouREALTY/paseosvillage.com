# Public site identity. Replace before publishing your own website.
NEXT_PUBLIC_SITE_NAME="The Paseo Village | Dr. Jan Duffy"
NEXT_PUBLIC_TITLE="Paseos Village Summerlin Realtor | Dr. Jan Duffy"
NEXT_PUBLIC_DESCRIPTION="An open-source Next.js starter with page metadata, sitemaps, social images, and practical SEO examples."
# A complete origin without a path. Local default: http://localhost:3000.
# Vercel defaults to its own project/preview domain when this is empty.
NEXT_PUBLIC_URL=""
# Optional: opt out of production indexing. Preview/local builds are always noindex.
# NEXT_PUBLIC_INDEXABLE="false"
# Optional: your own Google Analytics ID. No author tracking is configured.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-..."
# Production origin for The Paseo Village site, e.g. https://paseosvillage.com
# Calendly (defaults to Dr. Duffy's public page) and RealScout widget id:
# NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/drjanduffy"
# NEXT_PUBLIC_REALSCOUT_AGENT_ID=""
