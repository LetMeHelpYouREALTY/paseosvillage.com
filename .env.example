# Public site identity.
NEXT_PUBLIC_SITE_NAME="The Paseos Summerlin"
NEXT_PUBLIC_TITLE="The Paseos Summerlin | Las Vegas 89138"
NEXT_PUBLIC_DESCRIPTION="The Paseos is a Summerlin village in Las Vegas, NV 89138, with parks, trails, and homes west of the 215."
# Full origin, no path. Local default: http://localhost:3000.
NEXT_PUBLIC_URL=""
# Optional: force noindex in production. Preview and local builds are always noindex.
# NEXT_PUBLIC_INDEXABLE="false"
# Optional Google Analytics ID. No ID is set by default.
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-..."
# Google Search Console verification token (content value only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# RealScout agent id. Defaults to Dr. Jan’s widget id when unset.
# NEXT_PUBLIC_REALSCOUT_AGENT_ID=""
# Follow Up Boss API key. Server only. Never expose this in the browser.
# FUB_API_KEY=""
